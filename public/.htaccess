# Better Measure — static site (Next.js export) for Apache / cPanel
# Pages are clean directory URLs (e.g. /talk-to-us/), served via index.html.

# No directory listings
Options -Indexes

# Friendly 404
ErrorDocument 404 /404.html

# Serve the right index for directory URLs
DirectoryIndex index.html

# Long-cache the hashed, immutable build assets and images
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|png|jpe?g|svg|ico)$">
    Header set Cache-Control "public, max-age=15552000"
  </FilesMatch>
</IfModule>

# Gzip where available
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/manifest+json
</IfModule>
